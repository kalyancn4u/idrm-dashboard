# =============================================================================
#  IDRM — Environment Contract
#  Copy to `.env` and adjust.  `make env` does this for you.
# =============================================================================

# --- Flask --------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_NAME=IDRM
APP_TAGLINE=Identity Data & Risk Management

# --- Postgres (REQUIRED) ------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=idrm
PGPASSWORD=idrm
PGDATABASE=idrm

# SQLAlchemy URL — keep in sync with the PG* values above
DATABASE_URL=postgresql+psycopg2://idrm:idrm@localhost:5432/idrm

# Pool tuning
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_RECYCLE=1800

# --- Redis (OPTIONAL — leave blank to disable) --------------------------------
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- Session ------------------------------------------------------------------
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=480
REMEMBER_COOKIE_DAYS=14

# --- Domain knobs -------------------------------------------------------------
# Days of inactivity before an account is considered dormant
IDRM_DORMANCY_DAYS=90
# Days a finding may remain open before it breaches SLA (per severity)
IDRM_SLA_CRITICAL_DAYS=7
IDRM_SLA_HIGH_DAYS=14
IDRM_SLA_MEDIUM_DAYS=30
IDRM_SLA_LOW_DAYS=90
# Auto-run the risk engine on boot (dev convenience)
IDRM_RUN_SCAN_ON_BOOT=0

# --- Test ---------------------------------------------------------------------
# Leave blank to run tests on SQLite; set to a Postgres URL to run everything
IDRM_TEST_DATABASE_URL=
